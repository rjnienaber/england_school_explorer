{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "lib/**/*.ts",
    "dimensions/**/*.ts"
  ],
  "exclude": [
    "dimensions/**/web.ts",
    "dimensions/**/web-*.ts"
  ]
}
